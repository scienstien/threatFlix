# Backend Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
PORT=8000
NODE_ENV=development
DATABASE_PATH=./data/threatflix.db

# Optional ML Service (anomaly scoring sidecar)
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_MS=2000

# Local Ollama Configuration
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_REPORT_TIMEOUT_MS=120000
OLLAMA_CHAT_TIMEOUT_MS=60000
OLLAMA_KEEP_ALIVE=10m

# Graph Similarity Configuration
GRAPH_SIMILARITY_ENABLED=true
GRAPH_SIMILARITY_MAX_CANDIDATES=500
GRAPH_SIMILARITY_API_DEFAULT_LIMIT=5
GRAPH_SIMILARITY_API_MAX_LIMIT=20
GRAPH_SIMILARITY_LLM_LIMIT=3
GRAPH_SIMILARITY_MIN_SCORE=0.3

# JWT Configuration
JWT_EXPIRES_IN_SECONDS=86400

# Analysis Rate Limiting
ANALYSIS_COOLDOWN_MS=120000
ANALYSIS_EVENT_THRESHOLD=5
ANALYSIS_MAX_PER_MINUTE=5
ANALYSIS_GLOBAL_MAX_PER_MINUTE=100
THREATFLIX_DEMO_DEFER_ANALYSIS=false

# General API Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# Judge Demo Configuration
JUDGE_DEMO_PORT=4100
THREATFLIX_URL=http://127.0.0.1:8000/api
THREATFLIX_API_KEY=demo-api-key-replace-with-real-key